# Supabase project settings — find these in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vision-capable model for the import/extraction step (Step 1: Universal Import)
ANTHROPIC_API_KEY=

# Cloudflare R2 (S3-compatible) — unused as of the local-first audio change
# (lib/localAudio.ts): master audio now stays on the musician's own machine
# and is never uploaded, and artwork stays on Supabase Storage rather than
# moving here. lib/r2/storage.ts is kept in place, idle, in case artwork
# moves to R2 later — safe to leave these unset unless that happens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Stripe (test mode while developing) — Own Your Music, $49 one-time
# purchase. STRIPE_PRICE_ID must be a Price ID (starts with "price_"), not a
# Product ID (starts with "prod_") — the billing page fetches the price live
# from Stripe rather than hardcoding the amount, but it still needs the
# right kind of id to resolve. Find these in the Stripe Dashboard
# (Developers > API keys, and Developers > Webhooks for the signing secret
# once a webhook endpoint pointing at /api/webhooks/stripe is configured).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Local-dev-only fallback identity (lib/auth/currentUser.ts) — never used in
# a production build (`next build`/`next start`, including every Vercel
# deployment), only `next dev`. Real users sign up/log in via /signup and
# /login (Supabase Auth, email + password) and don't need this at all. Set
# this only if you want `npm run dev` to skip logging in locally: create a
# Supabase auth user (Dashboard > Authentication > Add user, or
# `insert into auth.users ...` in the SQL editor), then paste its UUID here.
DEV_USER_ID=
