# Supabase project settings — find these in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vision-capable model for the import/extraction step (Step 1: Universal Import)
ANTHROPIC_API_KEY=

# Cloudflare R2 (S3-compatible) — private bucket for track audio. Artwork
# stays on Supabase Storage; only audio moved here, since Supabase's plan-
# level file size cap (as low as 50MB depending on plan) is too small for
# uncompressed WAV masters. Find these in the Cloudflare dashboard under
# R2 Object Storage: R2_ACCOUNT_ID on the overview page, the other two from
# "Manage R2 API Tokens" (scope the token to just this bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# v0 (personal use) has no login flow yet — the confirm-and-save step attributes
# every album to this single Supabase auth user via the admin client. Create the
# user first (Supabase Dashboard > Authentication > Add user, or `insert into
# auth.users ...` in the SQL editor), then paste its UUID here.
DEV_USER_ID=
